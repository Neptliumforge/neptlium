{
  "name": "@neptlium/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib unit vitest.config.ts --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:node",
    "test:node": "node --test test/*.test.ts test/*.test.mjs",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@neptlium/ui": "workspace:*",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.16",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "description": "Neptlium public website.",
  "type": "module"
