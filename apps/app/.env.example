# Clerk is the browser authentication/session authority.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/complete
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/complete

# Server-side application routing/configuration. Presence does not prove API capability.
NEPTLIUM_API_URL=https://api.neptlium.com
NEXT_PUBLIC_SITE_URL=https://app.neptlium.com

# Temporary existing-account identity bridge only. These are browser-safe values;
# privileged Supabase credentials must never be configured in apps/app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
