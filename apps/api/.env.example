# Runtime. These safe defaults mirror source defaults where present; copy this file to an untracked local env file.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3003
API_LOG_LEVEL=info
API_BUILD_ID=local
# Production must use https://app.neptlium.com,https://admin.neptlium.com (never *).
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
APP_ORIGIN=https://app.neptlium.com
API_ORIGIN=https://api.neptlium.com

# Server-only Supabase data/authority configuration. SUPABASE_SERVICE_ROLE_KEY is sensitive.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Capability gate. Configuration presence does not verify live capability or authorize execution.
ENABLE_MAINNET=false

# Alchemy observation/RPC infrastructure. Secrets/signing material are server-only.
ALCHEMY_API_KEY=
ALCHEMY_ENVIRONMENT=testnet
ALCHEMY_RPC_URL=
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_PRODUCTION_CAPABILITY_VERIFIED=false

# Circle provider configuration. Credentials/entity secret are sensitive and server-only.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENVIRONMENT=testnet
CIRCLE_WALLET_SET_ID=
CIRCLE_LIVE_CAPABILITY_VERIFIED=false
CIRCLE_LIVE_EXECUTION_ENABLED=false

# Stripe Treasury configuration. Keys and webhook secret are sensitive and server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TREASURY_FINANCIAL_ACCOUNT_ID=
STRIPE_TREASURY_ELIGIBILITY_VERIFIED=false
STRIPE_TREASURY_LIVE_EXECUTION_ENABLED=false

WEBHOOK_TOLERANCE_SECONDS=300

# CONFIGURED != CAPABILITY VERIFIED.
# SOURCE SUPPORT != LIVE AVAILABILITY.
