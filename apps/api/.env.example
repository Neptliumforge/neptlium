# Runtime. These safe defaults mirror source defaults where present; copy this file to an untracked local env file.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3003
API_LOG_LEVEL=info
API_BUILD_ID=local
# Production must use https://app.neptlium.com,https://admin.neptlium.com (never *).
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
APP_ORIGIN=https://app.neptlium.com
API_ORIGIN=https://api.neptlium.com

# Supabase Auth is the sole runtime authentication provider for customer and admin bearer tokens.
SUPABASE_URL=
# Public/legacy data-access compatibility key where required by server code. Do not expose service-role credentials.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Capability gate. Configuration presence does not verify live capability or authorize execution.
ENABLE_MAINNET=false

# Alchemy — multi-chain blockchain connectivity, observation and intelligence.
# CURRENT runtime still consumes ALCHEMY_RPC_URL as a single-network endpoint.
# TARGET runtime uses a canonical chain registry and independently certified per-network endpoints/capabilities.
# Do not interpret an Alchemy-supported network as a Neptlium-enabled financial network.
# Secrets/signing material are server-only.
ALCHEMY_API_KEY=
ALCHEMY_ENVIRONMENT=testnet
ALCHEMY_RPC_URL=
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_PRODUCTION_CAPABILITY_VERIFIED=false

# Circle — supported stablecoin/digital-money wallet and settlement infrastructure.
# Circle provider state is evidence, never canonical Neptlium financial truth.
# Credentials/entity secret are sensitive and server-only.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENVIRONMENT=testnet
CIRCLE_WALLET_SET_ID=
CIRCLE_LIVE_CAPABILITY_VERIFIED=false
CIRCLE_LIVE_EXECUTION_ENABLED=false

# Neptlium product-level economic gates. Keep all false until the exact capability is separately certified and authorized.
ENABLE_WALLET_PROVISIONING=false
ENABLE_CRYPTO_DEPOSITS=false
ENABLE_CRYPTO_WITHDRAWALS=false

# Stripe — supported fiat/card/bank-payment and billing infrastructure.
# Current Stripe ingress handles subscription billing only. Capital funding remains disabled until a separately reviewed funding contract is implemented and certified.
# Provider payment success is evidence and does not bypass Neptlium ledger/reconciliation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

WEBHOOK_TOLERANCE_SECONDS=300

# PROVIDER OBSERVATION != CANONICAL LEDGER.
# CONFIGURED != CAPABILITY VERIFIED.
# CAPABILITY VERIFIED != EXECUTION AUTHORIZED.
# SUBMITTED != SETTLED.
# SETTLED != RECONCILED.
