NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3003
API_LOG_LEVEL=info
API_BUILD_ID=local
# Production must use https://app.neptlium.com,https://admin.neptlium.com (never *).
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
APP_ORIGIN=https://app.neptlium.com
API_ORIGIN=https://api.neptlium.com

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Permits production/mainnet provider configuration only. It does not authorize execution.
ENABLE_MAINNET=false

# Alchemy is observation/RPC infrastructure. Use base-mainnet for production and
# base-sepolia for testnet. Observations never become canonical balances directly.
ALCHEMY_API_KEY=
ALCHEMY_ENVIRONMENT=testnet
ALCHEMY_RPC_URL=
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_PRODUCTION_CAPABILITY_VERIFIED=false

# Circle Developer-Controlled Wallets. Production and testnet credentials/objects are
# distinct. Never reuse a testnet wallet set ID in production. Wallet creation and
# transaction submission remain disabled by application code until separately authorized.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENVIRONMENT=testnet
CIRCLE_WALLET_SET_ID=
CIRCLE_LIVE_CAPABILITY_VERIFIED=false
CIRCLE_LIVE_EXECUTION_ENABLED=false

# Stripe Treasury is fail-closed. Ordinary Stripe API access, charges_enabled, or
# payouts_enabled do not prove Treasury eligibility.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TREASURY_FINANCIAL_ACCOUNT_ID=
STRIPE_TREASURY_ELIGIBILITY_VERIFIED=false
STRIPE_TREASURY_LIVE_EXECUTION_ENABLED=false

WEBHOOK_TOLERANCE_SECONDS=300
