NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3003
API_LOG_LEVEL=info
API_BUILD_ID=local
API_ALLOWED_ORIGINS=http://localhost:3000
APP_ORIGIN=https://app.neptlium.com
API_ORIGIN=https://api.neptlium.com

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

ALCHEMY_API_KEY=
ALCHEMY_RPC_URL=
ALCHEMY_WEBHOOK_SIGNING_KEY=
COINBASE_WEBHOOK_SIGNING_KEY=

# Current Circle execution runtime remains testnet-only. LIVE capability flags below do
# not enable mainnet execution and must remain false until production capability review.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENVIRONMENT=testnet
CIRCLE_WALLET_SET_ID=
CIRCLE_LIVE_CAPABILITY_VERIFIED=false
CIRCLE_LIVE_EXECUTION_ENABLED=false

# Stripe Treasury is fail-closed. Do not set either verification/activation gate true
# merely because ordinary Stripe payments or ACH Payments capabilities are active.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TREASURY_FINANCIAL_ACCOUNT_ID=
STRIPE_TREASURY_ELIGIBILITY_VERIFIED=false
STRIPE_TREASURY_LIVE_EXECUTION_ENABLED=false

WEBHOOK_TOLERANCE_SECONDS=300
ENABLE_MAINNET=false
