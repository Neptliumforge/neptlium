{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/should-ignore-vercel-build.sh",
  "framework": null,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**"] }
    },
    {
      "src": "api/stripe-webhook.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**"] }
    }
  ],
  "routes": [
    { "src": "/v1/webhooks/stripe", "dest": "/api/stripe-webhook.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
