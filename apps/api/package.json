{
  "name": "@neptlium/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch dist/server.js",
    "build": "rm -rf dist && rm -f tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.mjs",
    "clean": "rm -rf dist",
    "vercel-build": "node build-vercel.mjs"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0"
  },
  "devDependencies": {}
}
