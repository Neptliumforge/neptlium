# Supabase Auth authenticates the human session only. Organization and treasury authority remain server-owned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical product/API origins. Presence does not enable payment execution.
NEPTLIUM_API_URL=https://api.neptlium.com
NEXT_PUBLIC_SITE_URL=https://vault.neptlium.com
