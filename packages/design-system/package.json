{
  "name": "@neptlium/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neptlium shared utility CSS and Tailwind compatibility configuration.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./utilities.css": "./src/utilities.css",
    "./tailwind": "./tailwind.config.ts"
  },
  "files": [
    "src",
    "tailwind.config.ts",
    "README.md"
  ],
  "dependencies": {
    "@neptlium/ui": "workspace:*"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3"
  }
}
