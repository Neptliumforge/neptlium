# =========================================================
# NEPTLIUM
# Production .gitignore
# Next.js 15 + Turborepo + pnpm + Supabase + Vercel
# =========================================================

# Dependencies
node_modules/
.pnpm-store/

# Build output
build/
dist/
out/
coverage/
.nyc_output/
.next/
**/.next/
.turbo/
.vercel/

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.*.json

# Runtime
pids/
*.pid
*.pid.lock
*.seed

# Cache and framework-local output
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.svelte-kit/
.nuxt/
.output/
.docusaurus/
.fusebox/
.vitest/
playwright-report/
test-results/
.firebase/
.serverless/
.dynamodb/

# Local development tools
.claude/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# Operating systems
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
*~

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# Package archives
*.tgz

# Misc
.node_repl_history
.tern-port
.lock-wscript

# Supabase local development
# Keep repository structure; ignore generated local state.
supabase/.temp/
supabase/.branches/
supabase/.cache/

# Generated documentation/artifacts
*.pdf
*.zip

# Never ignore repository structure
!.gitkeep
!.github/
!README.md
!LICENSE
